msgstr "Odkrýt"

#: src/app/ui/launcher/apps.controller.c:868
msgid "Hide"
msgstr "Skrýt"

#: src/app/ui/launcher/apps.controller.c:872
#: src/app/ui/launcher/server.context_menu.c:83
