#: src/app/ui/help/help.dialog.c:33
msgid "Controls & shortcuts"
msgstr "Ovládání a zkratky"

#: src/app/ui/help/help.dialog.c:60
msgid ""
"During streaming, use these shortcuts to control Aurora. Scroll with Up/Down "
"or the mouse wheel. Press Back/B/Escape to close this guide."
msgstr ""
"Během streamování můžete Aurora ovládat těmito zkratkami. Posouvejte šipkami "
"nahoru/dolů nebo kolečkem myši. Průvodce zavřete tlačítkem Zpět/B/Esc."

#: src/app/ui/help/help.dialog.c:62
msgid "TV remote"
msgstr "TV ovladač"

#: src/app/ui/help/help.dialog.c:63
msgid "Hold Back / press Red or Exit"
msgstr "Podržet Zpět / stisknout červené tlačítko nebo Exit"

#: src/app/ui/help/help.dialog.c:64
msgid ""
"Open the stream menu. A short Back press sends Escape to the PC; holding "
"Back on a Magic Remote sends Exit."
msgstr ""
"Otevře nabídku streamu. Krátké stisknutí Zpět odešle do PC Esc; podržení "
"Zpět na Magic Remote odešle Exit."

#: src/app/ui/help/help.dialog.c:65
msgid "Blue"
msgstr "Modré tlačítko"

#: src/app/ui/help/help.dialog.c:65
msgid "Open the on-screen keyboard. Press Back to close it."
msgstr "Otevře klávesnici na obrazovce. Zavřete ji tlačítkem Zpět."

#: src/app/ui/help/help.dialog.c:66
msgid "Hold OK (0.6 s), then release"
msgstr "Podržet OK (0,6 s) a uvolnit"

#: src/app/ui/help/help.dialog.c:66
msgid "Right-click on the PC. A short OK press sends Enter."
msgstr ""
"Provede kliknutí pravým tlačítkem na PC. Krátké stisknutí OK odešle Enter."

#: src/app/ui/help/help.dialog.c:67
msgid "Channel Up / Down"
msgstr "Kanál nahoru / dolů"

#: src/app/ui/help/help.dialog.c:67
msgid "Send Page Up / Page Down to the PC."
msgstr "Odešle do PC Page Up / Page Down."

#: src/app/ui/help/help.dialog.c:68
msgid "Send the Windows key to the PC (Start menu)."
msgstr "Odešle do PC klávesu Windows (nabídka Start)."

#: src/app/ui/help/help.dialog.c:69
msgid "Send Numpad 0–9 to the PC."
msgstr "Odešle do PC klávesy numerické klávesnice 0–9."

#: src/app/ui/help/help.dialog.c:70
msgid "Yellow"
msgstr "Žluté tlačítko"

#: src/app/ui/help/help.dialog.c:70
msgid "Cycle the diagnostic log overlay: Off, Live, Frozen."
msgstr ""
"Přepíná zobrazení diagnostického protokolu: vypnuto, živě, pozastaveno."

#: src/app/ui/help/help.dialog.c:72 src/app/ui/settings/panes/input.pane.c:88
msgid "Gamepad"
msgstr "Gamepad"

#: src/app/ui/help/help.dialog.c:73
msgid "LB + RB + Back + Start, then release all"
msgstr "LB + RB + Back + Start, poté vše uvolnit"

#: src/app/ui/help/help.dialog.c:73
msgid "Open the stream menu."
msgstr "Otevře nabídku streamu."

#: src/app/ui/help/help.dialog.c:74
msgid "Hold Select / Back (4 s)"
msgstr "Podržet Select / Back (4 s)"

#: src/app/ui/help/help.dialog.c:75
msgid ""
"Show or hide pinned performance stats. Hold this button alone; it is also "
"sent to the PC."
msgstr ""
"Zobrazí nebo skryje připnuté statistiky výkonu. Držte pouze toto tlačítko; "
"odesílá se také do PC."

#: src/app/ui/help/help.dialog.c:76
msgid "Y / Triangle with virtual mouse enabled"
msgstr "Y / trojúhelník při zapnuté virtuální myši"

#: src/app/ui/help/help.dialog.c:76
msgid "Open the on-screen keyboard."
msgstr "Otevře klávesnici na obrazovce."

#: src/app/ui/help/help.dialog.c:78 src/app/ui/settings/panes/input.pane.c:97
msgid "Virtual mouse"
msgstr "Virtuální myš"

#: src/app/ui/help/help.dialog.c:79
msgid ""
"Enable Virtual mouse in the stream menu, or enable it in Settings > Input to "
"start each stream with it."
msgstr ""
"Virtuální myš zapněte v nabídce streamu nebo v Nastavení > Vstup, chcete-li "
"ji používat od začátku každého streamu."

#: src/app/ui/help/help.dialog.c:80
msgid "Right stick / Left stick"
msgstr "Pravá / levá páčka"

#: src/app/ui/help/help.dialog.c:80
msgid "Move the pointer / scroll."
msgstr "Pohyb ukazatele / posouvání."

#: src/app/ui/help/help.dialog.c:81
msgid "LT / RT"
msgstr "LT / RT"

#: src/app/ui/help/help.dialog.c:81
msgid "Left-click / right-click."
msgstr "Levé / pravé kliknutí."

#: src/app/ui/help/help.dialog.c:83
msgid "On-screen keyboard"
msgstr "Klávesnice na obrazovce"

#: src/app/ui/help/help.dialog.c:84
msgid "D-pad + A / OK"
msgstr "Směrový ovladač + A / OK"

#: src/app/ui/help/help.dialog.c:84
msgid "Move between keys and press the selected key."
msgstr "Přechází mezi klávesami a stiskne vybranou klávesu."

#: src/app/ui/help/help.dialog.c:85
msgid "Y / X / Start"
msgstr "Y / X / Start"

#: src/app/ui/help/help.dialog.c:85
msgid "Space / Backspace / Enter (standard gamepad layout)."
msgstr "Mezerník / Backspace / Enter (běžné rozložení gamepadu)."

#: src/app/ui/help/help.dialog.c:86
msgid "LT / LB / RB"
msgstr "LT / LB / RB"

#: src/app/ui/help/help.dialog.c:86
msgid "Switch letters and symbols / move the text cursor left / right."
msgstr "Přepíná písmena a symboly / posouvá textový kurzor vlevo / vpravo."

#: src/app/ui/help/help.dialog.c:87
msgid "B / Back"
msgstr "B / Back"

#: src/app/ui/help/help.dialog.c:87
msgid "Close the keyboard. Gamepad B also sends Escape to the PC."
msgstr "Zavře klávesnici. Tlačítko B na gamepadu také odešle do PC Esc."

#: src/app/ui/help/help.dialog.c:89
msgid "Leaving a stream"
msgstr "Opuštění streamu"

#: src/app/ui/help/help.dialog.c:90 src/app/ui/streaming/streaming.view.c:141
msgid "Disconnect"
msgstr "Odpojit"

#: src/app/ui/help/help.dialog.c:90
msgid ""
"Return to Aurora and leave the application running on the PC so you can "
"resume later."
msgstr ""
"Vrátí se do Aurora a ponechá aplikaci na PC spuštěnou pro pozdější "
"pokračování."

#: src/app/ui/help/help.dialog.c:91
#: src/app/ui/streaming/streaming.controller.c:646
#: src/app/ui/streaming/streaming.view.c:151
msgid "End session"
msgstr "Ukončit relaci"

#: src/app/ui/help/help.dialog.c:91
msgid ""
"Ask the host to close the application after confirmation. Not available for "
"Remote Monitor / Remote Input streams."
msgstr ""
"Po potvrzení požádá hostitele o zavření aplikace. Nedostupné pro streamy "
"Remote Monitor / Remote Input."

