msgstr "Pro nastavení intervalu zapněte pravidelnou obnovu dekodéru."

#: src/app/ui/settings/panes/basic.pane.c:274
msgid "Adaptive bitrate"
msgstr "Adaptivní datový tok"

#: src/app/ui/settings/panes/basic.pane.c:276
msgid "Profile"
msgstr "Profil"

#: src/app/ui/settings/panes/basic.pane.c:282
