#. apploader has error
#: src/app/ui/launcher/apps.controller.c:456
msgid "Failed to load apps"
msgstr "Nepodařilo se načíst aplikace"

#: src/app/ui/launcher/apps.controller.c:457
#: src/app/ui/launcher/apps.controller.c:486
msgid ""
"Press \"Retry\" to load again.\n"
"\n"
"Restart your computer if error persists."
msgstr ""
"Pro znovunačtení stiskněte tlačítko \"Zkusit znovu\".\n"
"\n"
"Pokud chyba přetrvává, zkuste restartovat počítač."

#: src/app/ui/launcher/apps.controller.c:474
msgid "Not paired"
msgstr "Není spárováno"

#: src/app/ui/launcher/apps.controller.c:475
msgid "Press \"Pair\" to pair this host with your account."
msgstr "Stisknutím \"Párovat\" spárujete tohoto hostitele se svým účtem."

#. server has error
#: src/app/ui/launcher/apps.controller.c:485
msgid "Host error"
msgstr "Chyba hostitele"

#. server has error
#: src/app/ui/launcher/apps.controller.c:496
msgid "Offline"
msgstr "Offline"

#: src/app/ui/launcher/apps.controller.c:497
msgid ""
"Press \"Wake\" to send Wake-on-LAN packet to turn the computer on if it "
"supports this feature, press \"Retry\" to connect again.\n"
"\n"
"Try restart your computer if these doesn't work."
msgstr ""
"Stisknutím tlačítka \"Probudit\" odešlete Wake-on-LAN paket a zapnete "
"počítač, pokud tuto funkci podporuje, stisknutím tlačítka \"Zkusit znovu\" "
"se znovu připojíte.\n"
"\n"
"Pokud tyto pokusy nefungují, zkuste restartovat počítač."

#: src/app/ui/launcher/apps.controller.c:731
msgid "Quitting game..."
msgstr "Ukončuji hru..."

#: src/app/ui/launcher/apps.controller.c:801
msgid "Unable to quit game"
msgstr "Nelze ukončit hru"

#: src/app/ui/launcher/apps.controller.c:802
msgid "Please make sure you are quitting with the same client."
msgstr "Ujistěte se, že ukončujete se stejným klientem."

#: src/app/ui/launcher/apps.controller.c:853
msgid "Resume streaming"
msgstr "Pokračovat ve streamování"

#: src/app/ui/launcher/apps.controller.c:854
msgid "Start streaming"
msgstr "Zahájit streamování"

#: src/app/ui/launcher/apps.controller.c:860
msgid "Stop streaming"
msgstr "Zastavit streamování"

#: src/app/ui/launcher/apps.controller.c:864
msgid "Unstar"
msgstr "Odebrat z oblíbených"

#: src/app/ui/launcher/apps.controller.c:864
msgid "Star"
msgstr "Přidat k oblíbeným"

#: src/app/ui/launcher/apps.controller.c:868
