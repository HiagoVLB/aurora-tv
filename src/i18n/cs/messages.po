msgid "Close"
msgstr "Zavřít"

#: src/app/ui/launcher/server.popup.c:381
msgid ""
"No paired computers yet. Use the \"+\" button on the top bar to add one."
msgstr ""
"Zatím nejsou spárovány žádné počítače. Přidejte počítač tlačítkem \"+\" v "
"horní liště."

#. The stream was live and the game is still on the PC: offer to resume it.
#: src/app/ui/root.c:425
msgid "Reconnect"
msgstr "Znovu připojit"

#: src/app/ui/root.c:428
msgid ""
"The game keeps running on the PC. Reconnect to continue where you left off."
msgstr "Hra na PC dál běží. Znovu se připojte a pokračujte tam, kde jste skončili."

#: src/app/ui/root.c:429
msgid "Stream interrupted"
msgstr "Stream přerušen"

#: src/app/ui/root.c:435
msgid "Failed to start streaming"
msgstr "Nepodařilo se spustit streamování"

#: src/app/ui/settings/panes/av_pane.c:29
msgid ""
"Aurora uses moonlight-embedded to select a suitable decoder automatically."
msgstr "Aurora pomocí moonlight-embedded automaticky vybere vhodný dekodér."

#: src/app/ui/settings/panes/av_pane.c:50
#, c-format
msgid "%s is conflicting with %s"
msgstr "%s je v konfliktu s %s"

