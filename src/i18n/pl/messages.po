msgstr "Zamknij"

#: src/app/ui/launcher/server.popup.c:381
msgid ""
"No paired computers yet. Use the \"+\" button on the top bar to add one."
msgstr ""
"Brak sparowanych komputerów. Dodaj komputer przyciskiem \"+\" na górnym "
"pasku."

#: src/app/ui/root.c:413
msgid "Failed to start streaming"
msgstr "Nie udało się rozpocząć streamowania"

#: src/app/ui/settings/panes/av_pane.c:29
msgid ""
"Aurora uses moonlight-embedded to select a suitable decoder automatically."
msgstr ""
"Aurora używa moonlight-embedded, aby automatycznie wybrać odpowiedni dekoder."

#: src/app/ui/settings/panes/av_pane.c:50
#, c-format
msgid "%s is conflicting with %s"
msgstr "%s powoduje konflikt z %s"

#: src/app/ui/settings/panes/basic.pane.c:97
msgid "Balanced"
msgstr "Zrównoważony"

#: src/app/ui/settings/panes/basic.pane.c:98
msgid "Quality"
msgstr "Jakość"

#: src/app/ui/settings/panes/basic.pane.c:99
msgid "Low latency"
msgstr "Niskie opóźnienie"

#: src/app/ui/settings/panes/basic.pane.c:105
msgid "Auto"
msgstr "Automatycznie"

#: src/app/ui/settings/panes/basic.pane.c:158
#: src/app/ui/streaming/streaming.view.c:249
msgid "Resolution"
msgstr "Rozdzielczość"

#: src/app/ui/settings/panes/basic.pane.c:172
msgid "Frame rate"
msgstr "Liczba klatek na sekundę"

#: src/app/ui/settings/panes/basic.pane.c:179
#: src/app/ui/settings/panes/basic.pane.c:272
msgid "Bitrate"
msgstr "Przepływność"

#: src/app/ui/settings/panes/basic.pane.c:195
#: src/app/ui/streaming/streaming.view.c:251
msgid "Video backend"
msgstr "Backend wideo"

#: src/app/ui/settings/panes/basic.pane.c:202
msgid "HEVC"
msgstr "HEVC"

#: src/app/ui/settings/panes/basic.pane.c:206
msgid "AV1"
msgstr "AV1"

#: src/app/ui/settings/panes/basic.pane.c:216
msgid "HDR"
msgstr "HDR"

#: src/app/ui/settings/panes/basic.pane.c:220
msgid "10-bit SDR"
msgstr "10-bitowy SDR"

#: src/app/ui/settings/panes/basic.pane.c:222
msgid "Requires HEVC or AV1. Only used with HDR off."
msgstr "Wymaga HEVC lub AV1. Używane tylko przy wyłączonym HDR."

#: src/app/ui/settings/panes/basic.pane.c:224
#: src/app/ui/streaming/streaming.view.c:255
msgid "Audio"
msgstr "Dźwięk"

#: src/app/ui/settings/panes/basic.pane.c:231
#: src/app/ui/streaming/streaming.view.c:250
msgid "Video"
msgstr "Wideo"

#: src/app/ui/settings/panes/basic.pane.c:233
msgid "Full range YUV (SDR only)"
msgstr "Pełny zakres YUV (tylko SDR)"

#: src/app/ui/settings/panes/basic.pane.c:237
msgid "Turn HDR off to use this option."
msgstr "Wyłącz HDR, aby użyć tej opcji."

#: src/app/ui/settings/panes/basic.pane.c:239
msgid "HEVC sliced frames"
msgstr "Klatki HEVC podzielone na wycinki"

#: src/app/ui/settings/panes/basic.pane.c:243
#: src/app/ui/settings/panes/basic.pane.c:256
msgid "HEVC only. Unavailable with AV1."
msgstr "Tylko HEVC. Niedostępne z AV1."

#: src/app/ui/settings/panes/basic.pane.c:246
msgid "Periodic decoder refresh (HEVC)"
msgstr "Okresowe odświeżanie dekodera (HEVC)"

#: src/app/ui/settings/panes/basic.pane.c:261
#: src/app/ui/settings/panes/basic.pane.c:412
#: src/app/ui/settings/panes/basic.pane.c:415
msgid "Refresh interval"
msgstr "Odstęp odświeżania"

#: src/app/ui/settings/panes/basic.pane.c:267
msgid "Enable periodic decoder refresh to adjust the interval."
msgstr "Włącz okresowe odświeżanie dekodera, aby ustawić odstęp."

#: src/app/ui/settings/panes/basic.pane.c:274
msgid "Adaptive bitrate"
msgstr "Adaptacyjna przepływność"

#: src/app/ui/settings/panes/basic.pane.c:276
msgid "Profile"
msgstr "Profil"

#: src/app/ui/settings/panes/basic.pane.c:282
msgid "Enable adaptive bitrate to choose a profile."
msgstr "Włącz adaptacyjną przepływność, aby wybrać profil."

#: src/app/ui/settings/panes/basic.pane.c:314
msgid "HEVC and AV1 are alternatives. Selecting one turns the other off."
msgstr "HEVC i AV1 to alternatywy. Włączenie jednego wyłącza drugi."

#: src/app/ui/settings/panes/basic.pane.c:315
#: src/app/ui/settings/panes/basic.pane.c:318
msgid "Unavailable with this video backend."
msgstr "Niedostępne w tym mechanizmie wideo."

#: src/app/ui/settings/panes/basic.pane.c:317
