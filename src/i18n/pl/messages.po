"Adres IP: %s\n"
"GPU: %s\n"
"Obsługa 4K: %s\n"
"Obsługa HDR: %s\n"
"Wersja oprogramowania hosta: %s\n"
"GeForce Experience: %s"

#: src/app/ui/launcher/server.context_menu.c:187
msgid "Save"
msgstr "Zapisz"

#: src/app/ui/launcher/server.context_menu.c:199
