msgstr "Wybierz serwer"

#: src/app/ui/launcher/launcher.controller.c:630
msgid "No working decoder"
msgstr "Brak działającego dekodera"

#: src/app/ui/launcher/launcher.controller.c:634
msgid ""
"Streaming can't work without a valid decoder.\n"
"(If your device supports moonlight-embedded, install it and Aurora will use "
"it automatically.)"
msgstr ""
"Transmisja wymaga prawidłowego dekodera.\n"
"(Jeśli urządzenie obsługuje moonlight-embedded, zainstaluj go, a Aurora "
"użyje go automatycznie.)"

#: src/app/ui/launcher/launcher.controller.c:638
msgid "Streaming can't work without a valid decoder."
msgstr "Transmisja wymaga prawidłowego dekodera."

#: src/app/ui/launcher/launcher.controller.c:645
msgid "Can't save settings"
msgstr "Nie można zapisać ustawień"

#: src/app/ui/launcher/launcher.controller.c:648
msgid ""
"Can't find a writable directory to save settings. Settings and pairing "
"information will be lost when the TV is turned off.\n"
"\n"
"(If you're using webOS 3.0 or newer, restart the TV may fix this issue.)"
msgstr ""
"Nie znaleziono katalogu z prawem zapisu. Ustawienia i dane parowania zostaną "
"utracone po wyłączeniu telewizora.\n"
"\n"
"(W webOS 3.0 lub nowszym ponowne uruchomienie telewizora może rozwiązać "
"problem.)"

#: src/app/ui/launcher/pair.dialog.c:55
msgid "Pairing"
msgstr "Parowanie"

#: src/app/ui/launcher/pair.dialog.c:72
