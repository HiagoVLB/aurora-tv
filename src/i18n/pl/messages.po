#. apploader has error
#: src/app/ui/launcher/apps.controller.c:456
msgid "Failed to load apps"
msgstr "Nie udało się załadować aplikacji"

#: src/app/ui/launcher/apps.controller.c:457
#: src/app/ui/launcher/apps.controller.c:486
msgid ""
"Press \"Retry\" to load again.\n"
"\n"
"Restart your computer if error persists."
msgstr ""
"Naciśnij \"Ponów próbę\", aby wczytać ponownie.\n"
"\n"
"Jeśli błąd nie ustępuje, uruchom komputer ponownie."

#: src/app/ui/launcher/apps.controller.c:474
msgid "Not paired"
msgstr "Nie sparowano"

#: src/app/ui/launcher/apps.controller.c:475
msgid "Press \"Pair\" to pair this host with your account."
msgstr "Naciśnij \"Sparuj\", aby powiązać tego hosta ze swoim kontem."

#. server has error
#: src/app/ui/launcher/apps.controller.c:485
msgid "Host error"
msgstr "Błąd hosta"

#. server has error
#: src/app/ui/launcher/apps.controller.c:496
msgid "Offline"
msgstr "Offline"

#: src/app/ui/launcher/apps.controller.c:497
msgid ""
"Press \"Wake\" to send Wake-on-LAN packet to turn the computer on if it "
"supports this feature, press \"Retry\" to connect again.\n"
"\n"
"Try restart your computer if these doesn't work."
msgstr ""
"Naciśnij \"Wybudź\", aby włączyć komputer przez Wake-on-LAN, jeśli to "
"obsługuje, lub \"Ponów próbę\", aby połączyć się ponownie.\n"
"\n"
"Jeśli to nie pomoże, uruchom komputer ponownie."

#: src/app/ui/launcher/apps.controller.c:731
msgid "Quitting game..."
msgstr "Zamykanie gry..."

#: src/app/ui/launcher/apps.controller.c:801
