msgid "Y / X / Start"
msgstr "Y / X / Start"

#: src/app/ui/help/help.dialog.c:83
msgid "Space / Backspace / Enter (standard gamepad layout)."
msgstr "Boşluk / Backspace / Enter (standart kumanda düzeni)."

