#: src/app/ui/help/help.dialog.c:82
msgid "D-pad + A / OK"
msgstr "Yön tuşları + A / OK"

#: src/app/ui/help/help.dialog.c:82
msgid "Move between keys and press the selected key."
msgstr "Tuşlar arasında gezinir ve seçili tuşa basar."

