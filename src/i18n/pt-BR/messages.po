#: src/app/ui/help/help.dialog.c:33
msgid "Controls & shortcuts"
msgstr "Controles e atalhos"

#: src/app/ui/help/help.dialog.c:60
msgid ""
"During streaming, use these shortcuts to control Aurora. Scroll with Up/Down"
" or the mouse wheel. Press Back/B/Escape to close this guide."
msgstr ""
"Use estes atalhos para controlar o Aurora durante o streaming. Role com "
"Cima/Baixo ou com a roda do mouse. Pressione Voltar/B/Esc para fechar este "
"guia."

#: src/app/ui/help/help.dialog.c:62
msgid "TV remote"
msgstr "Controle da TV"

#: src/app/ui/help/help.dialog.c:63
msgid "Hold Back / press Red or Exit"
msgstr "Segurar Voltar / pressionar Vermelho ou Exit"

#: src/app/ui/help/help.dialog.c:64
msgid ""
"Open the stream menu. A short Back press sends Escape to the PC; holding "
"Back on a Magic Remote sends Exit."
msgstr ""
"Abre o menu do streaming. Um toque em Voltar envia Esc ao PC; segurar Voltar"
" no Magic Remote envia Exit."

#: src/app/ui/help/help.dialog.c:65
msgid "Blue"
msgstr "Azul"

#: src/app/ui/help/help.dialog.c:65
msgid "Open the on-screen keyboard. Press Back to close it."
msgstr "Abre o teclado na tela. Pressione Voltar para fechá-lo."

#: src/app/ui/help/help.dialog.c:66
msgid "Hold OK (0.6 s), then release"
msgstr "Segurar OK (0,6 s) e soltar"

#: src/app/ui/help/help.dialog.c:66
msgid "Right-click on the PC. A short OK press sends Enter."
msgstr "Envia um clique direito ao PC. Um toque em OK envia Enter."

#: src/app/ui/help/help.dialog.c:67
msgid "Channel Up / Down"
msgstr "Canal + / −"

#: src/app/ui/help/help.dialog.c:67
msgid "Send Page Up / Page Down to the PC."
msgstr "Envia Page Up / Page Down ao PC."

#: src/app/ui/help/help.dialog.c:68
msgid "Yellow"
msgstr "Amarelo"

#: src/app/ui/help/help.dialog.c:68
msgid "Cycle the diagnostic log overlay: Off, Live, Frozen."
msgstr ""
"Alterna o painel de logs de diagnóstico entre Desligado, Ao vivo e "
"Congelado."

#: src/app/ui/help/help.dialog.c:70 src/app/ui/settings/panes/input.pane.c:88
msgid "Gamepad"
msgstr "Controle de jogo"

#: src/app/ui/help/help.dialog.c:71
msgid "LB + RB + Back + Start, then release all"
msgstr "LB + RB + Back + Start e soltar todos"

#: src/app/ui/help/help.dialog.c:71
msgid "Open the stream menu."
msgstr "Abre o menu do streaming."

#: src/app/ui/help/help.dialog.c:72
msgid "Hold Select / Back (4 s)"
msgstr "Segurar Select / Back (4 s)"

#: src/app/ui/help/help.dialog.c:73
msgid ""
"Show or hide pinned performance stats. Hold this button alone; it is also "
"sent to the PC."
msgstr ""
"Mostra ou oculta as estatísticas fixas de desempenho. Segure apenas esse "
"botão; ele também é enviado ao PC."

#: src/app/ui/help/help.dialog.c:74
msgid "Y / Triangle with virtual mouse enabled"
msgstr "Y / Triângulo com o mouse virtual ativado"

#: src/app/ui/help/help.dialog.c:74
msgid "Open the on-screen keyboard."
msgstr "Abre o teclado na tela."

#: src/app/ui/help/help.dialog.c:76 src/app/ui/settings/panes/input.pane.c:97
msgid "Virtual mouse"
msgstr "Mouse virtual"

#: src/app/ui/help/help.dialog.c:77
msgid ""
"Enable Virtual mouse in the stream menu, or enable it in Settings > Input to"
" start each stream with it."
msgstr ""
"Ative o mouse virtual no menu do streaming ou em Configurações > Entrada "
"para usá-lo desde o início de cada transmissão."

#: src/app/ui/help/help.dialog.c:78
msgid "Right stick / Left stick"
msgstr "Analógico direito / esquerdo"

#: src/app/ui/help/help.dialog.c:78
msgid "Move the pointer / scroll."
msgstr "Move o ponteiro / rola a tela."

#: src/app/ui/help/help.dialog.c:79
msgid "LT / RT"
msgstr "LT / RT"

#: src/app/ui/help/help.dialog.c:79
msgid "Left-click / right-click."
msgstr "Clique esquerdo / direito."

#: src/app/ui/help/help.dialog.c:81
msgid "On-screen keyboard"
msgstr "Teclado na tela"

#: src/app/ui/help/help.dialog.c:82
msgid "D-pad + A / OK"
msgstr "Direcional + A / OK"

#: src/app/ui/help/help.dialog.c:82
msgid "Move between keys and press the selected key."
msgstr "Navega entre as teclas e pressiona a tecla selecionada."

#: src/app/ui/help/help.dialog.c:83
msgid "Y / X / Start"
msgstr "Y / X / Start"

#: src/app/ui/help/help.dialog.c:83
msgid "Space / Backspace / Enter (standard gamepad layout)."
msgstr "Espaço / Backspace / Enter (layout padrão do controle)."

#: src/app/ui/help/help.dialog.c:84
msgid "LT / LB / RB"
msgstr "LT / LB / RB"

#: src/app/ui/help/help.dialog.c:84
msgid "Switch letters and symbols / move the text cursor left / right."
msgstr ""
"Alterna letras e símbolos / move o cursor de texto para a esquerda / "
"direita."

#: src/app/ui/help/help.dialog.c:85
msgid "B / Back"
msgstr "B / Back"

#: src/app/ui/help/help.dialog.c:85
msgid "Close the keyboard. Gamepad B also sends Escape to the PC."
msgstr "Fecha o teclado. O botão B do controle também envia Esc ao PC."

#: src/app/ui/help/help.dialog.c:87
msgid "Leaving a stream"
msgstr "Sair do streaming"

#: src/app/ui/help/help.dialog.c:88 src/app/ui/streaming/streaming.view.c:123
msgid "Disconnect"
msgstr "Desconectar"

#: src/app/ui/help/help.dialog.c:88
msgid ""
"Return to Aurora and leave the application running on the PC so you can "
"resume later."
msgstr ""
"Volta ao Aurora e mantém o aplicativo aberto no PC para você retomar depois."

#: src/app/ui/help/help.dialog.c:89
#: src/app/ui/streaming/streaming.controller.c:649
#: src/app/ui/streaming/streaming.view.c:132
msgid "End session"
msgstr "Encerrar sessão"

#: src/app/ui/help/help.dialog.c:89
msgid ""
"Ask the host to close the application after confirmation. Not available for "
"Remote Monitor / Remote Input streams."
msgstr ""
"Solicita ao host o encerramento do aplicativo após confirmação. Indisponível"
" em transmissões Remote Monitor / Remote Input."

